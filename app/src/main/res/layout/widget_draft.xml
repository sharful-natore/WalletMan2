<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_draft_outer_bg"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_gradient_header_bg"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:gravity="center_vertical">
        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finance Note Drafts"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="দ্রুত লেনদেন ড্রাফট করে রাখুন"
                android:textColor="#F1F5F9"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_voice_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_round_btn_white"
            android:src="@drawable/ic_widget_mic_dark"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="12dp"
            android:elevation="4dp" />

        <ImageButton
            android:id="@+id/widget_add_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_round_btn_white"
            android:src="@drawable/ic_widget_add_dark"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:elevation="4dp" />
    </LinearLayout>

    <!-- List -->
    <ListView
        android:id="@+id/widget_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp" />
</LinearLayout>
