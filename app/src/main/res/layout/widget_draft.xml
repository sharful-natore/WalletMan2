<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- Header Container -->
    <FrameLayout
        android:id="@+id/widget_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/widget_header_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_draft_header_bg"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_f_logo"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/widget_f_logo_bg"
                        android:text="F"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Finance Note"
                        android:textColor="#1A1A1A"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/widget_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="লেনদেনের ড্রাফটসমূহঃ"
                        android:textColor="#595959"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/widget_info_button"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_info_circle"
                        android:contentDescription="Info"
                        android:padding="1dp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/widget_customize_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp">
                <ImageView
                    android:id="@+id/widget_customize_button_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_circle_solid" />
                <ImageView
                    android:id="@+id/widget_customize_button_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:src="@drawable/ic_palette"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_voice_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp">
                <ImageView
                    android:id="@+id/widget_voice_button_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_circle_solid" />
                <ImageView
                    android:id="@+id/widget_voice_button_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:src="@drawable/ic_widget_mic_dark"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_add_button"
                android:layout_width="34dp"
                android:layout_height="34dp">
                <ImageView
                    android:id="@+id/widget_add_button_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_circle_solid" />
                <ImageView
                    android:id="@+id/widget_add_button_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:src="@drawable/ic_widget_add_dark"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- List Section -->
    <FrameLayout
        android:id="@+id/widget_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/widget_list_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_draft_list_bg"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ListView
                android:id="@+id/widget_list_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp"
                android:scrollbarStyle="outsideOverlay" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
