<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/widget_summary_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_rounded_rect_bg"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_summary_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_summary_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 নিট হিসাব:"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginRight="6dp" />

        <TextView
            android:id="@+id/widget_summary_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="right"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
